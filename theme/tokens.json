{
  "name": "Ready Set New Midnight",
  "version": "1.0.0",
  "source": "Claude dark mode side panel combined with the grey and red alert banner, sampled from screenshots",
  "color": {
    "surface": {
      "bg":       { "value": "#09090b", "use": "page and side panel" },
      "surface":  { "value": "#0b0c0e", "use": "cards and code blocks" },
      "raised":   { "value": "#1a1c1e", "use": "raised strips and panels, alert strip" },
      "border":   { "value": "#222224", "use": "borders and dividers" },
      "selected": { "value": "#1e1917", "use": "selected row" }
    },
    "text": {
      "default": { "value": "#dedede" },
      "strong":  { "value": "#e8e6e3", "use": "text on red and strong emphasis" },
      "muted":   { "value": "#9e9e9e" },
      "accent":  { "value": "#d4a27f", "use": "selected labels, links, highlights" }
    },
    "signal": {
      "red":        { "value": "#790a02", "use": "alert body" },
      "redEdge":    { "value": "#d71204", "use": "alert edge line and errors" },
      "green":      { "value": "#90ee90", "use": "primary action, success, login frame" },
      "greenEdge":  { "value": "#5fbf6a" },
      "terminal":   { "value": "#00ff00", "use": "text-art and terminal glow" }
    }
  },
  "radius": { "default": "8px" },
  "font": {
    "sans": "system-ui, -apple-system, 'Segoe UI', sans-serif",
    "mono": "ui-monospace, 'SF Mono', 'DejaVu Sans Mono', Consolas, monospace"
  }
}
